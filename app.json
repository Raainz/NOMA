{
  "expo": {
    "name": "NOMA GPS Tracker",
    "slug": "noma",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0E27"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": false,
      "bundleIdentifier": "com.noma.gpstracker",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "NOMA needs access to your location to track your running activity.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NOMA needs background location access to continue tracking when your screen is locked.",
        "NSLocationAlwaysUsageDescription": "NOMA needs your location to track your running.",
        "UIRequiredDeviceCapabilities": [
          "gps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E27"
      },
      "package": "com.noma.gpstracker",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NOMA needs access to your location to track your running activity.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d2b43eeb-bb31-46e5-90f9-97501944184c"
      }
    },
    "owner": "nayta-team"
  }
}
