# Copy to .env and fill in. Never commit .env.
# Supabase: Project > Connect > copy the connection string (Session pooler or Direct), then put
# your database password in place of [YOUR-PASSWORD]. The postgresql:// form is accepted as is.
#   Direct / session pooler (port 5432): use this one to run `alembic upgrade head`.
#   Transaction pooler (port 6543): fine for the running API (prepared statements are disabled).
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
# Local alternative: postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/noma

# At least 32 random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_POINTS_PER_ACTIVITY=100000
